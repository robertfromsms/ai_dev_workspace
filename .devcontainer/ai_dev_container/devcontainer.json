{
  "name": "AI Dev Container",
  "initializeCommand": "make ai-dev-up",
  "dockerComposeFile": [
    "compose.ai-dev.yml"
  ],
  "service": "ai_dev_user",
  "workspaceFolder": "/workspace",
  "remoteUser": "human_user",

  // Avoid Dev Containers attempting to rewrite UID information at startup.
  "updateRemoteUserUID": false,
  "overrideCommand": false,

  // devContainer will not run the user's outside shell to discover envs
  "userEnvProbe": "none",

   "shutdownAction": "stopCompose"
}