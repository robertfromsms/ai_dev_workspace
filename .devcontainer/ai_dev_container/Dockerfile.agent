# syntax=docker/dockerfile:1

ARG NODE_VERSION=22-bookworm-slim

FROM node:${NODE_VERSION}

ARG USERNAME=agent
ARG USER_UID=43927
ARG USER_GID=43927

USER root

# install some relevant stuff
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        jq \
        less \
        make \
        procps \
        ripgrep \
        unzip \
        bubblewrap \
        python3 \
        python3-yaml \
        file \
        shellcheck \
    && rm -rf /var/lib/apt/lists/*

# install agent runtimes
RUN npm install --global \
        @openai/codex@0.155.1 \
        opencode-ai@1.18.31

# create the agent user
RUN groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd \
        --no-log-init \
        --uid "${USER_UID}" \
        --gid "${USER_GID}" \
        --create-home \
        --shell /bin/bash \
        "${USERNAME}" \
    && mkdir -p \
        /workspace \
        /home/${USERNAME}/.cache \
    && chown -R "${USER_UID}:${USER_GID}" \
        /workspace \
        /home/${USERNAME}

# mark the mounted workspace as a trusted Git repository
RUN git config --system --add safe.directory /workspace

USER ${USERNAME}

ENV HOME=/home/${USERNAME}

WORKDIR /workspace

CMD ["sleep", "infinity"]