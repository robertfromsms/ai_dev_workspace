ARG YQ_VERSION=4.52.5

FROM mikefarah/yq:${YQ_VERSION} AS yq

FROM node:22-bookworm-slim

USER root

# install some relevant stuff
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        procps \
        ripgrep \
        unzip \
        bubblewrap \
    && rm -rf /var/lib/apt/lists/*

# not sure if i will ever need yq again... i will leave ith ere
COPY --from=yq /usr/bin/yq /usr/local/bin/yq

# install codex cli
RUN npm install --global @openai/codex@0.145.0

# this is where you would install mcp
# you need to install them locally,
# then add corresponding mcp blocks in .codex/config.toml
# this is for Context7
RUN npm install --global @upstash/context7-mcp@3.2.5

# install more mcp locally here

# clean npm cache
RUN npm cache clean --force

CMD ["sleep", "infinity"]