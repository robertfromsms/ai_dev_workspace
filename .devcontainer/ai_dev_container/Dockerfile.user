# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/devcontainers/base:noble

ARG USERNAME=human_user
ARG USER_UID=43928
ARG USER_GID=43928

USER root

# General-purpose development tools.
RUN apt-get update \
    && export DEBIAN_FRONTEND=noninteractive \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        dnsutils \
        file \
        fzf \
        git-lfs \
        gnupg \
        jq \
        less \
        lsof \
        nano \
        netcat-openbsd \
        openjdk-21-jdk \
        openssh-client \
        pkg-config \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        ruby-full \
        ruby-dev \
        shellcheck \
        sqlite3 \
        tmux \
        tree \
        unzip \
        vim \
        wget \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Create the human development user.
RUN groupadd \
        --gid "${USER_GID}" \
        "${USERNAME}" \
    && useradd \
        --no-log-init \
        --uid "${USER_UID}" \
        --gid "${USER_GID}" \
        --create-home \
        --shell /bin/bash \
        "${USERNAME}" \
    && usermod -aG sudo "${USERNAME}" \
    && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" \
        > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}"

# Workspace owned by the human user.
RUN mkdir -p /workspace \
    && chown "${USER_UID}:${USER_GID}" /workspace

USER ${USERNAME}

ENV HOME=/home/${USERNAME}

WORKDIR /workspace

CMD ["sleep", "infinity"]