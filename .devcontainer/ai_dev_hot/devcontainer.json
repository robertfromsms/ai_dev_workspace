{
  "name": "AI Development (Hot)",
  "initializeCommand": "docker compose -f ${localWorkspaceFolder}/compose.ai-dev-cold.yml run --rm --build --no-deps ai_dev_cold_base /workspace/ai_dev_scripts/run-validate-with-project.sh",
  "dockerComposeFile": [
    "../../compose.ai-dev-with-project.yml"
  ],
  "service": "ai_dev_with_project",
  "workspaceFolder": "/workspace",
  "remoteUser": "agent",
  "updateRemoteUserUID": false,
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev",
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
