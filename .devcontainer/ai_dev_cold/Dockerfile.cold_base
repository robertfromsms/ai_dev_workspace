FROM debian:bookworm-slim

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        procps \
        ripgrep \
        unzip \
    && rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]