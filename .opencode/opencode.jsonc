{
  "$schema": "https://opencode.ai/config.json",

  // Keep sharing disabled if V2 adds support for it later.
  "share": "disabled",

  // Intended shell executable. The shell tool remains DENIED until
  // we prove V2 invokes this Bubblewrap wrapper.
  "shell": "/workspace/.opencode/bin/opencode-bubblewrap-wrapper",

  // V2 has no active native LSP runtime today. Keep it disabled if
  // one is introduced later; use the MCP-hosted LSPs instead.
  "lsp": false,

  // Do not launch formatters as another process-execution path.
  "formatter": false,

  // plugins, this block is used for future plugins as well
  "plugins": [
      {
        "package": "/workspace/.opencode/node_modules/rem-memory",
        "options": {
          "dir": "/home/agent/.local/share/opencode/memory"
        }
      }
  ],

  // V2 evaluates rules in order; the LAST matching rule wins.
  "permissions": [
    // Deny anything we have not explicitly reviewed.
    { "action": "*", "resource": "*", "effect": "deny" },

    // Approved native tools.
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },

    // Explicitly record the important denials.
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "browser", "resource": "*", "effect": "deny" },

    // specific settings for edit
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "/*", "effect": "deny" },
    { "action": "edit", "resource": "../*", "effect": "deny" },
    { "action": "edit", "resource": "*/../*", "effect": "deny" },

    // Context7.
    { "action": "context7_*", "resource": "*", "effect": "deny" },
    { "action": "context7_resolve-library-id", "resource": "*", "effect": "allow" },
    { "action": "context7_query-docs", "resource": "*", "effect": "allow" },

    // CodeGraph.
    { "action": "codegraph_*", "resource": "*", "effect": "deny" },
    { "action": "codegraph_codegraph_explore", "resource": "*", "effect": "allow" },

    // Java LSP MCP.
    { "action": "lsp_java_*", "resource": "*", "effect": "deny" },
    { "action": "lsp_java_definition", "resource": "*", "effect": "allow" },
    { "action": "lsp_java_references", "resource": "*", "effect": "allow" },
    { "action": "lsp_java_diagnostics", "resource": "*", "effect": "allow" },

    // Python LSP MCP: server disabled; keep these rules for later.
    { "action": "lsp_python_*", "resource": "*", "effect": "deny" },
    { "action": "lsp_python_definition", "resource": "*", "effect": "allow" },
    { "action": "lsp_python_references", "resource": "*", "effect": "allow" },
    { "action": "lsp_python_diagnostics", "resource": "*", "effect": "allow" },
    { "action": "lsp_python_hover", "resource": "*", "effect": "allow" },

    // TypeScript LSP MCP: server disabled.
    { "action": "lsp_typescript_*", "resource": "*", "effect": "deny" },
    { "action": "lsp_typescript_definition", "resource": "*", "effect": "allow" },
    { "action": "lsp_typescript_references", "resource": "*", "effect": "allow" },
    { "action": "lsp_typescript_diagnostics", "resource": "*", "effect": "allow" },
    { "action": "lsp_typescript_hover", "resource": "*", "effect": "allow" },

    // Ruby LSP MCP.
    { "action": "lsp_ruby_*", "resource": "*", "effect": "deny" },
    { "action": "lsp_ruby_definition", "resource": "*", "effect": "allow" },
    { "action": "lsp_ruby_references", "resource": "*", "effect": "allow" },
    { "action": "lsp_ruby_diagnostics", "resource": "*", "effect": "allow" },
    { "action": "lsp_ruby_hover", "resource": "*", "effect": "allow" },

    // Search MCPs: servers disabled; keep their allowlists for later.
    { "action": "brave_search_*", "resource": "*", "effect": "deny" },
    { "action": "brave_search_brave_web_search", "resource": "*", "effect": "allow" }
  ],

  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "http://mcp_gateway:8080/servers/context7/mcp",
        "disabled": false,
        "codemode": false,
        "oauth": false,
        "timeout": {
          "startup": 20000,
          "catalog": 20000,
          "execution": 60000
        }
      },

      "codegraph": {
        "type": "remote",
        "url": "http://mcp_gateway:8080/servers/codegraph/mcp",
        "disabled": false,
        "codemode": false,
        "oauth": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      },

      "lsp_java": {
        "type": "remote",
        "url": "http://mcp_gateway:8080/servers/lsp_java/mcp",
        "disabled": false,
        "codemode": false,
        "oauth": false,
        "timeout": {
          "startup": 100000,
          "catalog": 30000,
          "execution": 120000
        }
      },

      "lsp_python": {
        "type": "remote",
        "url": "http://mcp_gateway:8080/servers/lsp_python/mcp",
        "disabled": true,
        "codemode": false,
        "oauth": false,
        "timeout": {
          "startup": 100000,
          "catalog": 30000,
          "execution": 120000
        }
      },

      "lsp_typescript": {
        "type": "remote",
        "url": "http://mcp_gateway:8080/servers/lsp_typescript/mcp",
        "disabled": true,
        "codemode": false,
        "oauth": false,
        "timeout": {
          "startup": 100000,
          "catalog": 30000,
          "execution": 120000
        }
      },

      "lsp_ruby": {
        "type": "remote",
        "url": "http://mcp_gateway:8080/servers/lsp_ruby/mcp",
        "disabled": false,
        "codemode": false,
        "oauth": false,
        "timeout": {
          "startup": 100000,
          "catalog": 30000,
          "execution": 120000
        }
      },

      "brave_search": {
        "type": "remote",
        "url": "http://mcp_gateway:8080/servers/brave_search/mcp",
        "disabled": true,
        "codemode": false,
        "oauth": false,
        "timeout": {
          "startup": 20000,
          "catalog": 20000,
          "execution": 60000
        }
      }
    }
  }
}