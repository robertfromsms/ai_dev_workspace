{
  "mcpServers": {
    "context7": {
      "enabled": true,
      "command": "/usr/local/bin/context7-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "HOME": "/home/node",
        "PATH": "/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    },
    "brave_search": {
      "enabled": false,
      "command": "/usr/local/bin/brave-search-mcp-server",
      "args": [
        "--transport",
        "stdio",
        "--brave-api-key-file",
        "/run/secrets/brave_api_key",
        "--enabled-tools",
        "brave_web_search"
      ],
      "env": {
        "HOME": "/home/node",
        "PATH": "/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    },
    "searxng": {
      "enabled": true,
      "command": "/usr/local/bin/mcp-searxng",
      "env": {
        "SEARXNG_URL": "http://searxng:8080",
        "HOME": "/home/node",
        "PATH": "/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    },
    "codegraph": {
      "enabled": true,
      "command": "/usr/local/bin/codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "/workspace"
      ],
      "env": {
        "DO_NOT_TRACK": "1",
        "HOME": "/home/node",
        "PATH": "/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    },
    "lsp_java": {
      "enabled": true,
      "command": "/usr/local/bin/mcp-language-server",
      "args": [
        "--workspace",
        "/workspace",
        "--lsp",
        "/usr/local/bin/jdtls",
        "--",
        "-data",
        "/tmp/jdtls-workspace"
      ],
      "env": {
        "HOME": "/home/node",
        "JAVA_HOME": "/opt/java/openjdk",
        "PATH": "/opt/java/openjdk/bin:/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    },
    "lsp_python": {
      "enabled": false,
      "command": "/usr/local/bin/mcp-language-server",
      "args": [
        "--workspace",
        "/workspace",
        "--lsp",
        "/usr/local/bin/pyright-langserver",
        "--",
        "--stdio"
      ],
      "env": {
        "HOME": "/home/node",
        "PATH": "/opt/java/openjdk/bin:/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    },
    "lsp_typescript": {
      "enabled": false,
      "command": "/usr/local/bin/mcp-language-server",
      "args": [
        "--workspace",
        "/workspace",
        "--lsp",
        "/usr/local/bin/typescript-language-server",
        "--",
        "--stdio"
      ],
      "env": {
        "HOME": "/home/node",
        "PATH": "/opt/java/openjdk/bin:/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    },
    "lsp_ruby": {
      "enabled": true,
      "command": "/usr/local/bin/mcp-language-server",
      "args": [
        "--workspace",
        "/workspace",
        "--lsp",
        "/usr/local/bin/solargraph",
        "--",
        "stdio"
      ],
      "env": {
        "HOME": "/home/node",
        "PATH": "/opt/java/openjdk/bin:/opt/mcp-python/bin:/usr/local/bin:/usr/bin:/bin",
        "SOLARGRAPH_CACHE": "/var/cache/solargraph",
        "TMPDIR": "/tmp",
        "XDG_CACHE_HOME": "/tmp/cache"
      }
    }
  }
}
