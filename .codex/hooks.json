{
  "description": "Inject user-maintained current context before prompt submission, if it has changed.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tsx /workspace/.codex/hooks/mention_current_context.ts",
            "timeout": 5,
            "statusMessage": "Mentioning current context"
          }
        ]
      }
    ]
  }
}
